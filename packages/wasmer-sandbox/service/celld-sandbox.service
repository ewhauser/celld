[Unit]
Description=celld Wasmer executor with per-command resource limits
After=network.target

[Service]
Type=simple
User=celld
Group=celld
WorkingDirectory=/opt/celld-sandbox
Environment=CELLD_SANDBOX_CONFIG=/etc/celld-sandbox/config.json
EnvironmentFile=/etc/celld-sandbox/secrets.env
ExecStart=/bin/sh /opt/celld-sandbox/service/start-delegated.sh
Delegate=cpu memory pids
RuntimeDirectory=celld-executor
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=1
MemoryMax=3G
TasksMax=256
CPUQuota=200%
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
