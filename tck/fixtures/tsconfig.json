{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [],
    "noEmit": true
  },
  "include": [
    "core/**/*.ts",
    "shared/**/*.ts",
    "extensions/**/*.ts",
    "repro/**/*.ts",
    "recovery/**/*.ts",
    "qualification/**/*.ts"
  ]
}
